# ── Development / cost control ─────────────────────────────────────────────
# During development we run everything through Ollama Cloud's minimax-m3:cloud
# to keep spend low. Swap DEFAULT_PROVIDER/MODEL to a hosted provider later
# (or override per task below) once you're past dev.
DEFAULT_PROVIDER="ollama"
DEFAULT_MODEL="minimax-m3:cloud"

# Ollama Cloud via local `ollama serve` — no API key required.
OLLAMA_BASE_URL="http://localhost:11434"

# −− Alternate providers (optional, paid) −−−−−−−−−−−−−−−−−−
# GOOGLE_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Per-task provider overrides: AGENT_TASK_<TASK>_PROVIDER / AGENT_TASK_<TASK>_MODEL
# Tasks: research | edit | write | rate
# By default ALL tasks fall back to DEFAULT_PROVIDER/DEFAULT_MODEL (Ollama dev).
# Uncomment a task to give it a different provider or model:
# AGENT_TASK_EDIT_PROVIDER="ollama"
# AGENT_TASK_EDIT_MODEL="minimax-m3:cloud"
# AGENT_TASK_WRITE_PROVIDER="ollama"
# AGENT_TASK_WRITE_MODEL="minimax-m3:cloud"
# AGENT_TASK_RATE_PROVIDER="ollama"
# AGENT_TASK_RATE_MODEL="minimax-m3:cloud"
# AGENT_TASK_RESEARCH_PROVIDER="ollama"
# AGENT_TASK_RESEARCH_MODEL="minimax-m3:cloud"

# Firebase Config
FIREBASE_API_KEY="firebase api key"
FIREBASE_AUTH_DOMAIN="firebase auth domain"
FIREBASE_PROJECT_ID="firebase project id"
FIREBASE_STORAGE_BUCKET="firebase storage bucket"
FIREBASE_MESSAGING_SENDER_ID="firebase messaging sender id"
FIREBASE_APP_ID="firebase app id"
FIREBASE_MEASUREMENT_ID="firebase measurement id"
FIREBASE_SERVICE_ACCOUNT="path/to/service-account.json"

# Scheduling
CRON_SCHEDULE="30 6 * * *"